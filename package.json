{
  "name": "@screepts/rollup-plugin-screeps-world",
  "version": "1.0.1",
  "description": "Rollup Plugin for Screeps",
  "keywords": [
    "rolldown",
    "rollup",
    "screeps",
    "vite",
    "world"
  ],
  "license": "MIT",
  "contributors": [
    "Adam Laycock",
    "Carson Burke",
    "shanemadden",
    "ShuP1"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/screepts/rollup-plugin-screeps-world.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "node --run build",
    "lint": "oxlint --type-check --type-aware",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test:e2e": "vitest run --typecheck",
    "test": "node --run fmt:check && node --run lint"
  },
  "dependencies": {
    "screeps-api": "npm:@screepts/screeps-api@^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "oxfmt": ">=0.40.0 <2.0.0",
    "oxlint": "^1.50.0",
    "oxlint-tsgolint": ">=0.17.0 <2.0.0",
    "rollup": "^4.59.0",
    "rollup-plugin-typescript2": "^0.36.0",
    "tsdown": ">=0.22.3 <2.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.0.16"
  }
}
